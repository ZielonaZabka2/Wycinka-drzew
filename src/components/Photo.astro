---
// Zdjęcie z banku/klienta, jeśli istnieje plik src/assets/photos/<name>.(jpg|jpeg|png|webp),
// w przeciwnym razie autorska ilustracja SVG. Astro generuje AVIF/WebP w kilku rozmiarach.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Illustration from './Illustration.astro';
import type { Illustration as IllustrationVariant } from '../data/types';

interface Props {
  name: string;
  alt: string;
  fallback: IllustrationVariant;
  priority?: boolean;
  sizes?: string;
  class?: string;
}
const { name, alt, fallback, priority = false, sizes = '(min-width: 1024px) 560px, 100vw', class: cls } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
const img = match?.[1].default;
---
<div class:list={['photo', cls]}>
  {img ? (
    <Picture
      src={img}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
    />
  ) : (
    <Illustration variant={fallback} title={alt} />
  )}
</div>
<style>
  .photo { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--leaf-2); aspect-ratio: 5 / 4; }
  .photo :global(img), .photo :global(svg) { width: 100%; height: 100%; object-fit: cover; }
</style>
