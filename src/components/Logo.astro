---
// Znak: stylizowana korona drzewa z liną i karabinkiem (alpinistyka) + logotyp.
// Aby użyć oryginalnego logo firmy, wgraj plik do src/assets/photos/logo.png — patrz README.
interface Props { light?: boolean }
const { light = false } = Astro.props;
const text = light ? '#f3f1e8' : '#10231a';
---
<span class="logo">
  <svg width="44" height="44" viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="13" fill={light ? '#f5a524' : '#173f2a'} />
    <path d="M24 7l11 14h-5l6 9H12l6-9h-5z" fill={light ? '#173f2a' : '#dcebd3'} />
    <rect x="22" y="30" width="4" height="10" rx="1" fill={light ? '#173f2a' : '#dcebd3'} />
    <path d="M31 13v14" stroke="#f5a524" stroke-width="2.4" stroke-linecap="round" style={light ? 'stroke:#10231a' : ''} />
    <circle cx="31" cy="30" r="3" fill="none" stroke={light ? '#10231a' : '#f5a524'} stroke-width="2.2" />
  </svg>
  <span class="logo__text">
    <strong style={`color:${text}`}>SCH Wycinka Drzew</strong>
    <small style={`color:${light ? '#bfd0c3' : '#4f5b53'}`}>Alpinistyka · Zwyżka · Ostrołęka</small>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo svg { flex: none; }
  .logo__text { display: grid; line-height: 1.15; white-space: nowrap; }
  .logo__text strong { font-family: var(--display); font-size: 1.15rem; letter-spacing: -0.01em; }
  .logo__text small { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; }
</style>
