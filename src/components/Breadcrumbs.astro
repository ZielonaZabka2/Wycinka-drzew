---
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav class="bc" aria-label="Okruszki">
  <ol>
    <li><a href="/">Strona główna</a></li>
    {items.map((it, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={it.href}>{it.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .bc ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 24px; font-size: .9rem; color: var(--muted); }
  .bc li + li::before { content: '/'; margin-right: 6px; opacity: .6; }
  .bc a { color: var(--muted); }
  .bc a:hover { color: var(--forest-2); }
  .bc [aria-current] { color: var(--ink); font-weight: 600; }
</style>
