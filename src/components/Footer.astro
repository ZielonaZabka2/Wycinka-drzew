---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = 2026;
const services = [
  ['/uslugi/wycinka-drzew/', 'Wycinka drzew Ostrołęka'],
  ['/uslugi/wycinka-alpinistyczna/', 'Wycinka alpinistyczna'],
  ['/uslugi/podnosnik-koszowy-zwyzka/', 'Zwyżka / podnośnik koszowy'],
  ['/uslugi/prace-wysokosciowe/', 'Prace na wysokościach'],
  ['/uslugi/pielegnacja-drzew/', 'Pielęgnacja drzew'],
  ['/uslugi/odsniezanie-dachow/', 'Odśnieżanie dachów'],
];
const places = [
  ['/obszar-dzialania/ostroleka/', 'Ostrołęka'],
  ['/obszar-dzialania/rzekun/', 'Rzekuń'],
  ['/obszar-dzialania/olszewo-borki/', 'Olszewo-Borki'],
  ['/obszar-dzialania/lelis/', 'Lelis'],
  ['/obszar-dzialania/kadzidlo/', 'Kadzidło'],
  ['/obszar-dzialania/myszyniec/', 'Myszyniec'],
  ['/obszar-dzialania/', 'Cały obszar działania →'],
];
---
<footer class="ftr">
  <div class="container ftr__grid">
    <div class="ftr__brand">
      <Logo light />
      <p>Bezpieczna wycinka drzew metodą alpinistyczną i z podnośnika koszowego, prace wysokościowe i odśnieżanie dachów. Ostrołęka i okolice do ok. {site.serviceRadiusKm} km.</p>
      <address>
        <a class="ftr__line" href={site.phoneHref}><Icon name="phone" size={18} />{site.phone}</a>
        <a class="ftr__line" href={site.mapsUrl} rel="noopener" target="_blank"><Icon name="pin" size={18} />{site.address.street}, {site.address.postalCode} {site.address.city}</a>
        {site.email && <a class="ftr__line" href={`mailto:${site.email}`}>{site.email}</a>}
      </address>
    </div>
    <nav aria-label="Usługi">
      <p class="ftr__h">Usługi</p>
      <ul>{services.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
    </nav>
    <nav aria-label="Obszar działania">
      <p class="ftr__h">Obszar działania</p>
      <ul>{places.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
    </nav>
    <nav aria-label="Informacje">
      <p class="ftr__h">Informacje</p>
      <ul>
        <li><a href="/poradnik/pozwolenie-na-wycinke-drzew/">Pozwolenie na wycinkę</a></li>
        <li><a href="/faq/">Najczęstsze pytania</a></li>
        <li><a href="/o-nas/">O nas</a></li>
        <li><a href="/kontakt/">Kontakt i wycena</a></li>
        <li><a href="/polityka-prywatnosci/">Polityka prywatności</a></li>
      </ul>
    </nav>
  </div>
  <div class="container ftr__bottom">
    <p>© {year} {site.name}, Ostrołęka. Wszelkie prawa zastrzeżone.</p>
    <p>Aktualizacja treści: {new Date(site.lastUpdated).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
  </div>
</footer>
<a class="callbar" href={site.phoneHref}><Icon name="phone" />Zadzwoń – bezpłatna wycena</a>
<style>
  .ftr { background: var(--ink); color: var(--on-dark-muted); padding: 72px 0 96px; font-size: .97rem; }
  .ftr__grid { display: grid; gap: 40px; grid-template-columns: 1.4fr 1fr 1fr 1fr; }
  .ftr__brand p { margin: 20px 0; max-width: 42ch; }
  .ftr address { font-style: normal; display: grid; gap: 10px; }
  .ftr a { color: var(--on-dark); text-decoration: none; }
  .ftr a:hover { color: var(--accent); }
  .ftr__line { display: inline-flex; gap: 10px; align-items: flex-start; }
  .ftr__line :global(svg) { margin-top: 3px; color: var(--accent); }
  .ftr__h { font-family: var(--display); color: #fff; font-weight: 700; font-size: 1.05rem; margin-bottom: 14px; }
  .ftr ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .ftr ul a { display: inline-block; padding: 6px 0; }
  .ftr__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 56px; padding-top: 24px; border-top: 1px solid rgb(255 255 255 / .12); font-size: .88rem; }
  .ftr__bottom p { margin: 0; }
  @media (max-width: 960px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ftr__grid { grid-template-columns: minmax(0, 1fr); } }
  .callbar { display: none; }
  @media (max-width: 720px) {
    .callbar { display: flex; position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 60; min-height: 56px; align-items: center; justify-content: center; gap: 10px; border-radius: 999px; background: var(--accent); color: var(--ink); font-weight: 800; text-decoration: none; box-shadow: 0 10px 30px -8px rgb(16 35 26 / .55); }
    .callbar :global(svg) { width: 20px; height: 20px; }
  }
</style>
