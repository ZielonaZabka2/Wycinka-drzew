---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Bezpłatna wycena w 24 godziny', text = 'Zadzwoń lub wyślij SMS ze zdjęciem drzewa i adresem. Oddzwonimy, ocenimy sytuację i zaproponujemy najbezpieczniejszą metodę – alpinistycznie lub ze zwyżki.' } = Astro.props;
---
<section class="cta" aria-labelledby="cta-h">
  <div class="container cta__in">
    <div>
      <h2 id="cta-h">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
      <a class="btn btn--ghost" href={site.smsHref}><Icon name="sms" />Wyślij SMS ze zdjęciem</a>
    </div>
  </div>
</section>
<style>
  .cta { padding-block: clamp(40px, 6vw, 72px); }
  .cta__in { background: var(--forest) radial-gradient(circle at 90% 10%, rgb(245 165 36 / .22), transparent 45%); color: var(--on-dark); border-radius: calc(var(--radius) + 8px); padding: clamp(28px, 5vw, 56px); display: grid; grid-template-columns: 1.4fr auto; gap: 32px; align-items: center; }
  .cta h2 { color: #fff; margin-bottom: .3em; }
  .cta p { color: var(--on-dark-muted); margin: 0; max-width: 60ch; }
  .cta__actions { display: grid; gap: 12px; }
  @media (max-width: 820px) { .cta__in { grid-template-columns: minmax(0, 1fr); } }
</style>
