---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { locations } from '../../data/locations';
import { site } from '../../data/site';
import { faqSchema, howToSchema, BUSINESS_ID } from '../../data/schema';
import type { Service } from '../../data/types';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props as { service: Service };
const url = `${site.url}/uslugi/${service.slug}/`;
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const breadcrumbs = [
  { name: 'Usługi', href: '/uslugi/' },
  { name: service.name, href: `/uslugi/${service.slug}/` },
];
const serviceSchema = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: service.h1,
  serviceType: service.serviceType,
  description: service.lead,
  url,
  provider: { '@id': BUSINESS_ID },
  areaServed: locations.map((l) => ({ '@type': 'Place', name: l.name })),
  audience: { '@type': 'Audience', audienceType: 'Właściciele domów, wspólnoty mieszkaniowe, firmy i instytucje' },
  offers: { '@type': 'Offer', priceCurrency: 'PLN', availability: 'https://schema.org/InStock', description: 'Bezpłatna wycena po oględzinach lub na podstawie zdjęć', seller: { '@id': BUSINESS_ID } },
  keywords: service.keywords.join(', '),
};
---
<Base
  title={service.title}
  description={service.metaDescription}
  breadcrumbs={breadcrumbs}
  schema={[serviceSchema, howToSchema(`${service.name} – jak przebiega usługa`, service.steps), faqSchema(service.faq)]}
>
  <PageHero h1={service.h1} lead={service.lead} eyebrow="Usługa · Ostrołęka i okolice" breadcrumbs={breadcrumbs} illustration={service.illustration} photo={service.slug} photoAlt={`${service.name} – SCH Wycinka Drzew, Ostrołęka`} />

  <section class="svc-facts" aria-label="Usługa w skrócie">
    <div class="container">
      <dl class="grid grid-4">
        {service.facts.map((f) => (
          <div class="card kv"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container layout">
      <article class="prose">
        {service.sections.map((sec) => (
          <>
            <h2>{sec.h2}</h2>
            {sec.paragraphs.map((p) => <p set:html={p} />)}
            {sec.bullets && <ul>{sec.bullets.map((b) => <li set:html={b} />)}</ul>}
          </>
        ))}
      </article>
      <aside class="side">
        <div class="card side__box">
          <h2 class="side__h">Co obejmuje usługa?</h2>
          <ul class="checklist">{service.includes.map((i) => <li><span set:html={i} /></li>)}</ul>
        </div>
        <div class="card side__cta">
          <p class="side__h">Bezpłatna wycena</p>
          <p>Wyślij zdjęcie i adres SMS-em – odpowiemy z propozycją terminu.</p>
          <a class="btn btn--primary" href={site.phoneHref}><Icon name="phone" />{site.phone}</a>
          <a class="btn btn--dark" href={site.smsHref}><Icon name="sms" />Wyślij SMS</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="kroki-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Krok po kroku</p><h2 id="kroki-h">Jak przebiega {service.name.toLowerCase()}?</h2></div>
      <ol class="grid grid-3 stepsg">
        {service.steps.map((s, i) => (
          <li class="card"><span class="n">{i + 1}</span><h3>{s.name}</h3><p set:html={s.text} /></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="container narrow">
      <div class="section-head"><p class="eyebrow">FAQ</p><h2 id="faq-h">Pytania o usługę: {service.name.toLowerCase()}</h2></div>
      <FaqList items={service.faq} open />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="gdzie-h">
    <div class="container">
      <div class="section-head"><h2 id="gdzie-h">{service.name} – gdzie dojeżdżamy?</h2><p class="lead">Baza w Ostrołęce, dojazd w promieniu ok. {site.serviceRadiusKm} km.</p></div>
      <ul class="chips">
        {locations.map((l) => <li><a href={`/obszar-dzialania/${l.slug}/`}>{l.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="inne-h">
    <div class="container">
      <div class="section-head"><h2 id="inne-h">Inne usługi</h2></div>
      <div class="grid grid-3">{others.map((s) => <ServiceCard service={s} />)}</div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .svc-facts { margin-top: -36px; position: relative; }
  .kv { margin: 0; padding: 20px 22px; }
  .kv dt { font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--moss); }
  .kv dd { margin: 4px 0 0; font-family: var(--display); font-size: 1.2rem; font-weight: 700; line-height: 1.25; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .side { position: sticky; top: 100px; display: grid; gap: 16px; }
  .side__h { font-family: var(--display); font-size: 1.3rem; font-weight: 700; margin-bottom: 16px; }
  .side__cta { background: var(--leaf-2); display: grid; gap: 10px; }
  .side__cta .side__h { margin-bottom: 0; }
  .side__cta p { margin: 0 0 6px; color: var(--muted); }
  @media (max-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr); } .side { position: static; } }
  .stepsg { list-style: none; padding: 0; margin: 0; }
  .stepsg .n { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--accent); font-weight: 800; margin-bottom: 14px; }
  .stepsg p { color: var(--muted); margin: 0; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips a { display: inline-block; padding: 10px 16px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; color: var(--ink); font-weight: 600; }
  .chips a:hover { border-color: var(--moss); }
</style>
