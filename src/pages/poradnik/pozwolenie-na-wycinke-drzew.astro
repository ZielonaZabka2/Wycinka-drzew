---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guide } from '../../data/guide';
import { site } from '../../data/site';
import { faqSchema, BUSINESS_ID } from '../../data/schema';
const path = '/poradnik/pozwolenie-na-wycinke-drzew/';
const breadcrumbs = [{ name: 'Poradnik', href: path }, { name: 'Pozwolenie na wycinkę drzew', href: path }];
const toId = (s: string, i: number) => `s${i + 1}`;
const article = {
  '@type': 'Article',
  '@id': `${site.url}${path}#article`,
  headline: guide.h1,
  description: guide.metaDescription,
  datePublished: '2026-09-30',
  dateModified: guide.updated,
  inLanguage: 'pl-PL',
  author: { '@id': BUSINESS_ID },
  publisher: { '@id': BUSINESS_ID },
  mainEntityOfPage: `${site.url}${path}`,
  image: `${site.url}/og-image.png`,
  about: [{ '@type': 'Thing', name: 'Zgłoszenie zamiaru usunięcia drzewa' }, { '@type': 'Legislation', name: 'Ustawa z dnia 16 kwietnia 2004 r. o ochronie przyrody', legislationIdentifier: 'Dz.U. 2004 nr 92 poz. 880' }],
};
---
<Base title={guide.title} description={guide.metaDescription} breadcrumbs={breadcrumbs.slice(1)} schema={[article, faqSchema(guide.faq)]}>
  <PageHero h1={guide.h1} lead={guide.lead} eyebrow={`Poradnik · aktualizacja ${new Date(guide.updated).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}`} breadcrumbs={breadcrumbs.slice(1)} />
  <section class="section" style="padding-top: 0">
    <div class="container">
      <dl class="grid grid-3 keys">
        {guide.keyFacts.map((f) => <div class="card"><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
    <div class="container layout">
      <nav class="toc card" aria-label="Spis treści">
        <p class="toc__h">Spis treści</p>
        <ol>{guide.sections.map((s, i) => <li><a href={`#${toId(s.h2, i)}`}>{s.h2}</a></li>)}</ol>
      </nav>
      <article class="prose">
        {guide.sections.map((sec, i) => (
          <>
            <h2 id={toId(sec.h2, i)}>{sec.h2}</h2>
            {sec.paragraphs.map((p) => <p set:html={p} />)}
            {sec.bullets && <ul>{sec.bullets.map((b) => <li set:html={b} />)}</ul>}
            {i === 0 && (
              <div class="table-wrap">
                <table>
                  <caption>{guide.table.caption}</caption>
                  <thead><tr>{guide.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                  <tbody>{guide.table.rows.map((r) => <tr>{r.map((c, j) => (j === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />))}</tr>)}</tbody>
                </table>
              </div>
            )}
          </>
        ))}
        <p class="disclaimer">Poradnik ma charakter informacyjny i nie stanowi porady prawnej. Przepisy mogą się zmieniać – przed wycinką potwierdź wymagania we właściwym urzędzie gminy lub miasta. Podstawa prawna: ustawa z dnia 16 kwietnia 2004 r. o ochronie przyrody (art. 83–83f).</p>
      </article>
    </div>
  </section>
  <section class="section section--tint" aria-labelledby="faq-h">
    <div class="container narrow">
      <div class="section-head"><h2 id="faq-h">Pytania o pozwolenia na wycinkę</h2></div>
      <FaqList items={guide.faq} open />
    </div>
  </section>
  <CtaBand title="Nie wiesz, czy potrzebne jest zgłoszenie?" text="Podczas bezpłatnych oględzin zmierzymy obwód pnia, ocenimy stan drzewa i podpowiemy, jakie formalności obowiązują w Twojej gminie." />
</Base>
<style>
  .keys { margin: 0 0 48px; }
  .keys dt { font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--moss); }
  .keys dd { margin: 6px 0 0; font-family: var(--display); font-weight: 700; font-size: 1.15rem; line-height: 1.3; }
  .layout { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .toc { position: sticky; top: 100px; padding: 22px; }
  .toc__h { font-family: var(--display); font-weight: 700; margin-bottom: 10px; }
  .toc ol { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; font-size: .93rem; }
  .prose .table-wrap { margin: 8px 0 24px; }
  .disclaimer { font-size: .9rem; color: var(--muted); border-left: 3px solid var(--accent); padding-left: 14px; margin-top: 40px; }
  @media (max-width: 980px) { .layout { grid-template-columns: minmax(0, 1fr); } .toc { position: static; } }
</style>
