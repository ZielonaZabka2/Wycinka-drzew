---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { businessSchema, websiteSchema, breadcrumbSchema, BUSINESS_ID, WEBSITE_ID } from '../data/schema';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  ogImage?: string;
  noindex?: boolean;
  pageType?: string;
  datePublished?: string;
}
const {
  title,
  description,
  breadcrumbs = [],
  schema = [],
  ogImage = '/og-image.png',
  noindex = false,
  pageType = 'WebPage',
  datePublished = '2026-09-30',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const pageId = `${canonical}#webpage`;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    businessSchema(),
    websiteSchema(),
    {
      '@type': pageType,
      '@id': pageId,
      url: canonical,
      name: title,
      description,
      inLanguage: 'pl-PL',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': BUSINESS_ID },
      publisher: { '@id': BUSINESS_ID },
      datePublished,
      dateModified: site.lastUpdated,
      primaryImageOfPage: { '@type': 'ImageObject', url: new URL(ogImage, site.url).href },
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', '.bluf'] },
    },
    ...(breadcrumbs.length ? [breadcrumbSchema([{ name: 'Strona główna', href: '/' }, ...breadcrumbs])] : []),
    ...schema,
  ],
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="theme-color" content="#173f2a" />
    <meta name="geo.region" content="PL-14" />
    <meta name="geo.placename" content="Ostrołęka" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SCH Wycinka Drzew – wycinka drzew i zwyżka w Ostrołęce" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, site.url).href} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
